/* 태광러닝센터 전용 저장소. 스프레드시트에 연결된 Apps Script V8에서 사용합니다.
 * 스크립트 속성 SPREADSHEET_ID, SHARED_SECRET(32자 이상)을 먼저 설정합니다.
 * setupSheets를 1회 실행하고 웹 앱을 '나로 실행 / 모든 사용자'로 배포합니다.
 * 웹 앱 접근은 HMAC 서명으로 제한되며 공유 시트는 비공개로 유지합니다.
 */
const SCHEMA={courses:{name:'교육과정',fields:['id','title','category','date','endDate','startTime','endTime','place','capacity','instructorId','closed','description','target','objectives','curriculum','materials','notices'],labels:['과정ID','과정명','분야','시작일','종료일','시작시간','종료시간','장소','정원','강사ID','모집마감','과정설명','교육대상','학습목표','커리큘럼','준비물','안내사항']},apps:{name:'교육신청',fields:['id','courseId','name','employeeId','company','department','email','phone','reason','status','created'],labels:['신청ID','과정ID','성명','사번','회사','부서','이메일','휴대폰','신청사유','상태','신청일']},instructors:{name:'강사정보',fields:['id','name','company','position','birthYear','education','career','history','books','specialty','contact'],labels:['강사ID','성명','현소속','직책','출생연도','학력','경력','강의이력','저서','전문분야','연락처']}};
function book_(){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw Error('SPREADSHEET_ID 미설정');return SpreadsheetApp.openById(id)}
function error_(message,status){const e=new Error(message);e.status=status;throw e}
function response_(value){return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON)}
function setupSheets(){const book=book_();for(const config of Object.values(SCHEMA)){let sheet=book.getSheetByName(config.name)||book.insertSheet(config.name);sheet.getRange(1,1,1,config.labels.length).setValues([config.labels]).setFontWeight('bold').setBackground('#2c2722').setFontColor('#ffffff');sheet.setFrozenRows(1);sheet.getRange(1,1,Math.max(2,sheet.getMaxRows()),config.labels.length).setNumberFormat('@')}
 let state=book.getSheetByName('_저장소');if(!state){state=book.insertSheet('_저장소');state.getRange(1,1,1,2).setValues([['1','2']]);const initial=JSON.stringify({courses:[],apps:[],instructors:[]});state.getRange(2,1,1,2).setValues([['1',initial]]);state.hideSheet()}
}
function read_(book){const sheet=book.getSheetByName('_저장소');if(!sheet)throw Error('setupSheets를 먼저 실행하세요.');const pointer=sheet.getRange(1,1,1,2).getDisplayValues()[0],row=Number(pointer[1]);const values=sheet.getRange(row,1,1,sheet.getLastColumn()).getValues()[0];if(String(values[0])!==String(pointer[0]))throw Error('저장소 버전 불일치');return {revision:Number(pointer[0]),state:JSON.parse(values.slice(1).join(''))}}
function commit_(book,previous,state){validateState_(state);const sheet=book.getSheetByName('_저장소'),pointer=sheet.getRange(1,1,1,2).getDisplayValues()[0],row=Number(pointer[1])===2?3:2,revision=previous+1,text=JSON.stringify(state),chunks=[];if(text.length>6000000)error_('저장소가 커졌습니다. 사진 크기와 데이터를 정리하세요.',413);for(let i=0;i<text.length;i+=40000)chunks.push(text.slice(i,i+40000));const count=1+chunks.length;if(sheet.getMaxColumns()<count)sheet.insertColumnsAfter(sheet.getMaxColumns(),count-sheet.getMaxColumns());sheet.getRange(row,1,1,sheet.getLastColumn()).clearContent();sheet.getRange(row,1,1,count).setNumberFormat('@').setValues([[String(revision)].concat(chunks)]);SpreadsheetApp.flush();sheet.getRange(1,1,1,2).setValues([[String(revision),String(row)]]);SpreadsheetApp.flush();let warning='';try{project_(book,state)}catch(e){warning='데이터 저장은 완료했지만 보기용 탭 갱신에 실패했습니다. syncViewSheets를 실행하세요.'}return {revision,courses:state.courses,apps:state.apps,instructors:state.instructors,warning}}
function project_(book,state){for(const [key,config]of Object.entries(SCHEMA)){const sheet=book.getSheetByName(config.name);if(!sheet)continue;if(sheet.getLastRow()>1)sheet.getRange(2,1,sheet.getLastRow()-1,config.fields.length).clearContent();if(state[key].length){if(sheet.getMaxRows()<state[key].length+1)sheet.insertRowsAfter(sheet.getMaxRows(),state[key].length+1-sheet.getMaxRows());sheet.getRange(2,1,state[key].length,config.fields.length).setNumberFormat('@').setValues(state[key].map(item=>config.fields.map(field=>{let value=item[field];value=value===undefined?'':String(value);return /^[=+@-]/.test(value)?"'"+value:value})))}}}
function syncViewSheets(){const book=book_();project_(book,read_(book).state)}
function validId_(value){return typeof value==='string'&&/^[A-Za-z0-9_-]{1,100}$/.test(value)}
function validateState_(state){if(!state||!['courses','apps','instructors'].every(key=>Array.isArray(state[key])&&state[key].length<=10000))error_('저장 데이터 형식을 확인하세요.',400);for(const key of ['courses','apps','instructors']){const ids=new Set();for(const item of state[key]){if(!item||!validId_(item.id)||ids.has(item.id))error_('데이터 ID가 올바르지 않거나 중복됩니다.',400);ids.add(item.id)}}for(const c of state.courses){if(!c.title||!Number.isInteger(c.capacity)||c.capacity<1||c.capacity>10000||!/^\d{4}-\d{2}-\d{2}$/.test(c.date))error_('교육과정 필수값을 확인하세요.',400);if(c.instructorId&&!state.instructors.some(i=>i.id===c.instructorId))error_('등록되지 않은 강사입니다.',400)}for(const i of state.instructors){if(!i.name||!i.company)error_('강사 성명과 현소속이 필요합니다.',400);if(i.photo&&!/^data:image\/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$/.test(i.photo))error_('강사 사진 형식을 확인하세요.',400)}for(const a of state.apps){if(!state.courses.some(c=>c.id===a.courseId)||!['신청완료','승인','반려','취소'].includes(a.status))error_('신청 과정이나 상태를 확인하세요.',400)}for(const c of state.courses){if(state.apps.filter(a=>a.courseId===c.id&&!['취소','반려'].includes(a.status)).length>c.capacity)error_('교육 정원을 초과합니다.',409)}}
function public_(record){const s=record.state,counts={};for(const c of s.courses)counts[c.id]=s.apps.filter(a=>a.courseId===c.id&&!['취소','반려'].includes(a.status)).length;return {revision:record.revision,courses:s.courses,instructors:s.instructors.map(i=>Object.fromEntries(['id','name','company','position','education','career','history','books','specialty','photo'].map(key=>[key,i[key]||'']))),counts,totalApplications:s.apps.length,approvedApplications:s.apps.filter(a=>a.status==='승인').length}}
function apply_(book,record,input){if(!input||!validId_(input.id))error_('신청 식별자가 올바르지 않습니다.',400);const old=record.state.apps.find(a=>a.id===input.id);if(old){if(['courseId','name','employeeId','phone'].some(k=>old[k]!==input[k]))error_('동일 요청 식별자의 내용이 다릅니다.',409);return {applicationId:old.id,status:old.status,duplicateRequest:true}}
 for(const key of ['courseId','name','employeeId','company','department','email','phone'])if(typeof input[key]!=='string'||!input[key].trim())error_('교육신청 필수 정보를 입력하세요.',400);if(!/^010\d{8}$/.test(input.phone)||!/^\S+@\S+\.\S+$/.test(input.email)||Object.values(input).some(value=>typeof value==='string'&&value.length>1000))error_('연락처 또는 신청 내용을 확인하세요.',400);const course=record.state.courses.find(c=>c.id===input.courseId),today=Utilities.formatDate(new Date(),'Asia/Seoul','yyyy-MM-dd');if(!course||course.closed||course.date<today)error_('신청할 수 없는 교육과정입니다.',409);const active=record.state.apps.filter(a=>a.courseId===course.id&&!['취소','반려'].includes(a.status));if(active.some(a=>a.employeeId.toLowerCase()===input.employeeId.toLowerCase()))error_('해당 사번으로 이미 신청한 과정입니다.',409);if(active.length>=course.capacity)error_('교육 정원이 마감되었습니다.',409);const application=Object.assign({},input,{status:'신청완료',created:today});record.state.apps.push(application);commit_(book,record.revision,record.state);return {applicationId:application.id,status:application.status}}
function doPost(e){let lock;try{const envelope=JSON.parse(e.postData.contents),properties=PropertiesService.getScriptProperties(),secret=properties.getProperty('SHARED_SECRET');if(!secret||secret.length<32)error_('저장소 인증 설정이 필요합니다.',503);if(Math.abs(Date.now()-Number(envelope.timestamp))>300000)error_('요청 유효시간 초과',403);const expected=Utilities.computeHmacSha256Signature(envelope.timestamp+'.'+envelope.body,secret).map(b=>('0'+((b+256)%256).toString(16)).slice(-2)).join('');if(expected!==envelope.signature)error_('저장소 인증 실패',403);const request=JSON.parse(Utilities.newBlob(Utilities.base64Decode(envelope.body)).getDataAsString('UTF-8'));lock=LockService.getScriptLock();if(!lock.tryLock(20000))error_('다른 신청을 처리 중입니다. 잠시 후 재시도하세요.',503);const book=book_(),record=read_(book);let data;if(request.action==='public')data=public_(record);else if(request.action==='admin')data=Object.assign({revision:record.revision},record.state);else if(request.action==='apply')data=apply_(book,record,request.payload.application);else if(request.action==='save'||request.action==='reset'){if(Number(request.payload.revision)!==record.revision)error_('다른 사용자가 데이터를 변경했습니다. 새로고침 후 다시 저장하세요.',409);data=commit_(book,record.revision,request.action==='reset'?{courses:[],apps:[],instructors:[]}:request.payload.state)}else error_('지원하지 않는 요청',400);return response_({ok:true,data})}catch(error){return response_({ok:false,status:error.status||503,error:error.message||'저장소 오류'})}finally{if(lock)lock.releaseLock()}}
